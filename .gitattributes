# Deterministic line endings.
#
# Development happens on Windows and CI runs on Ubuntu. Without this, Git
# guesses per file, diffs fill with whole-file changes when a Windows and a
# Linux checkout disagree, and a shell script can arrive on the runner with
# CRLF endings that make it fail to execute.
#
# Everything textual is normalised to LF in the repository. Git still checks
# out CRLF on Windows where the platform expects it.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.m4a binary
*.ogg binary

# The lockfile is generated; keep it out of diff review noise.
package-lock.json -diff linguist-generated

# Curriculum data files are large and hand-authored. Marking them as such
# keeps GitHub's language statistics honest about what this project is.
content/**/*.ts linguist-language=TypeScript
